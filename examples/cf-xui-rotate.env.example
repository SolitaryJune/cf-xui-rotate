# /etc/cf-xui-rotate.env — cf-xui-rotate 配置文件
# 权限必须是 600(root:root),脚本以 root 运行

# ---- Cloudflare API(需要 Zone.DNS Edit 权限,建议最小化) ----
CF_API_TOKEN=
CF_ZONE_ID=

# ---- 核心配置 ----
# 优选域名:一条 DNS-only(灰云)A 记录,由脚本自动更新指向最优边缘 IP。
# 客户端订阅中的连接地址就是它,轮换后无需改任何客户端配置。
OPT_DOMAIN=best.example.com

# 业务域名:开启小黄云、回源到你本机的域名,作为 TLS SNI 和 HTTP Host。
TARGET_HOST=node.example.com

# xHTTP 路径(需与 Nginx / Xray 入站配置一致)
TEST_PATH=/your-xhttp-path

# ---- 可选项 ----
# x-ui hosts 表中由本脚本托管的条目备注
#HOSTS_REMARK=CF优选
# x-ui 入站 ID
#INBOUND_ID=1
# 候选域名(逗号分隔;解析结果会被过滤为 Cloudflare 官方 IPv4 段)
#CANDIDATE_DOMAINS=openai.com,cloudflare.com,www.cloudflare.com,workers.dev
# DNS 记录 TTL(秒)
#DNS_TTL=120
# 每个候选 IP 的探测轮数(取中位数)
#PROBE_ROUNDS=2
